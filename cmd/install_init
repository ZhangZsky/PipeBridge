#!/bin/bash
log_level() {
    local level="$1" message="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    case "$level" in
        "INFO")    echo "[$timestamp] [INFO]    $message" ;;
        "SUCCESS") echo "[$timestamp] [SUCCESS] $message" ;;
        "WARNING") echo "[$timestamp] [WARNING] $message" ;;
        "ERROR")   echo "[$timestamp] [ERROR]   $message" ;;
        "STEP")    echo "[$timestamp] [STEP]    $message" ;;
        "DETAIL")  echo "[$timestamp] [DETAIL]  $message" ;;
        *)         echo "[$timestamp] [INFO]    $message" ;;
    esac
}

log_level "STEP" "==================== PipeBridge 安装初始化 ===================="

log_level "STEP" "步骤1: 更新软件源"
apt-get update -qq >/dev/null && log_level "SUCCESS" "软件源更新成功" || log_level "ERROR" "软件源更新失败，继续尝试安装"

log_level "STEP" "步骤2: 安装依赖包"

PACKAGE_LIST=(
    "pipewire:PipeWire 音频服务"
    "pipewire-pulse:PipeWire PulseAudio 兼容层"
    "pipewire-alsa:PipeWire ALSA 桥接插件"
    "wireplumber:WirePlumber 会话管理"
    "libspa-0.2-bluetooth:PipeWire 蓝牙支持"
    "alsa-utils:speaker-test 声道测试工具（非 ALSA 操作，仅测试用）"
    "bluez:蓝牙协议栈"
    "bluez-tools:蓝牙 CLI 工具"
    "python3-dbus:Python D-Bus 支持"
    "python3-gi:PyGObject 支持"
    "python3-fastapi:FastAPI Web 框架"
    "python3-uvicorn:Uvicorn ASGI 服务器"
    "firmware-realtek:Realtek 固件"
    "bluez-firmware:蓝牙固件"
)

if dpkg -s firmware-linux-trim 2>/dev/null | grep -q "^Status: install ok installed"; then
    log_level "DETAIL" "firmware-linux-trim 已安装，跳过 firmware-realtek"
    NEW_LIST=()
    for entry in "${PACKAGE_LIST[@]}"; do
        [[ "$entry" != firmware-realtek:* ]] && NEW_LIST+=("$entry")
    done
    PACKAGE_LIST=("${NEW_LIST[@]}")
fi

BACKPORT_PKGS="pipewire pipewire-pulse pipewire-alsa wireplumber libspa-0.2-bluetooth"
USE_BACKPORTS=false
if dpkg -s libpipewire-0.3-0 2>/dev/null | grep -q "bookworm-backports"; then
    USE_BACKPORTS=true
    log_level "DETAIL" "libpipewire-0.3-0 来自 backports，PipeWire 包将从 backports 安装"
fi

MAIN_MISSING=()
PW_MISSING=()
for entry in "${PACKAGE_LIST[@]}"; do
    PKG_NAME="${entry%%:*}"
    PKG_DESC="${entry#*:}"
    if dpkg -s "$PKG_NAME" 2>/dev/null | grep -q "^Status: install ok installed"; then
        log_level "DETAIL" "$PKG_DESC ($PKG_NAME) 已安装，跳过"
    else
        if echo "$BACKPORT_PKGS" | grep -qw "$PKG_NAME"; then
            PW_MISSING+=("$PKG_NAME")
        else
            MAIN_MISSING+=("$PKG_NAME")
        fi
    fi
done

if [ ${#MAIN_MISSING[@]} -gt 0 ]; then
    log_level "INFO" "安装 ${#MAIN_MISSING[@]} 个包: ${MAIN_MISSING[*]}"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${MAIN_MISSING[@]}" >/dev/null
fi

if [ ${#PW_MISSING[@]} -gt 0 ]; then
    if [ "$USE_BACKPORTS" = true ]; then
        log_level "INFO" "从 backports 安装 ${#PW_MISSING[@]} 个 PipeWire 包: ${PW_MISSING[*]}"
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -t bookworm-backports "${PW_MISSING[@]}" >/dev/null
    else
        log_level "INFO" "安装 ${#PW_MISSING[@]} 个 PipeWire 包: ${PW_MISSING[*]}"
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${PW_MISSING[@]}" >/dev/null
        BP_RETRY=()
        for name in "${PW_MISSING[@]}"; do
            dpkg -s "$name" 2>/dev/null | grep -q "^Status: install ok installed" || BP_RETRY+=("$name")
        done
        if [ ${#BP_RETRY[@]} -gt 0 ]; then
            log_level "INFO" "从 backports 补装: ${BP_RETRY[*]}"
            DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -t bookworm-backports "${BP_RETRY[@]}" >/dev/null
        fi
    fi
fi

dpkg --configure -a >/dev/null 2>&1
apt-get install -f -y -qq >/dev/null

for entry in "${PACKAGE_LIST[@]}"; do
    PKG_NAME="${entry%%:*}"
    PKG_DESC="${entry#*:}"
    if dpkg -s "$PKG_NAME" 2>/dev/null | grep -q "^Status: install ok installed"; then
        log_level "SUCCESS" "$PKG_DESC ($PKG_NAME) 安装成功"
    else
        log_level "ERROR" "$PKG_DESC ($PKG_NAME) 安装失败"
    fi
done

log_level "STEP" "步骤3: 验证关键库文件"

SPA_BT_SO=$(dpkg -L libspa-0.2-bluetooth 2>/dev/null | grep -E '\.so$' | head -1)
if [ -n "$SPA_BT_SO" ] && [ -f "$SPA_BT_SO" ]; then
    log_level "SUCCESS" "SPA 蓝牙插件: $SPA_BT_SO"
else
    log_level "WARNING" "SPA 蓝牙插件缺失，尝试重装..."
    DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y -qq libspa-0.2-bluetooth >/dev/null
    SPA_BT_SO=$(dpkg -L libspa-0.2-bluetooth 2>/dev/null | grep -E '\.so$' | head -1)
    [ -n "$SPA_BT_SO" ] && [ -f "$SPA_BT_SO" ] && log_level "SUCCESS" "重装成功" || log_level "ERROR" "重装后仍缺失，蓝牙音频不可用"
fi

HOST_ARCH=$(dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo "")
SPA_BLUEZ5_DIR="/usr/lib/${HOST_ARCH:-x86_64-linux-gnu}/spa-0.2/bluez5"
[ -d "$SPA_BLUEZ5_DIR" ] && log_level "SUCCESS" "SPA bluez5 目录存在 ($SPA_BLUEZ5_DIR)" || log_level "ERROR" "SPA bluez5 目录缺失 ($SPA_BLUEZ5_DIR)"

log_level "STEP" "步骤4: 部署 WirePlumber 蓝牙配置"

for lua_dir in /etc/wireplumber/main.lua.d /root/.config/wireplumber/main.lua.d; do
    [ -d "$lua_dir" ] && rm -f "$lua_dir"/*pipebridge*.lua
done

WP_CONF_DIR="/etc/wireplumber/wireplumber.conf.d"
mkdir -p "$WP_CONF_DIR"
cat > "$WP_CONF_DIR/51-pipebridge-bluez.conf" << 'EOF'
wireplumber.profiles = {
  main = {
    monitor.bluez.seat-monitoring = disabled
  }
}

# 禁止蓝牙连接后自动成为默认输出：默认设备完全由用户手动掌控。
wireplumber.settings = {
    node.restore-default-targets = false
    bluetooth.autoswitch-to-headset-profile = false
}

monitor.bluez.properties = {
    bluez5.enable-sbc-xq = true
    bluez5.enable-msbc = true
    bluez5.enable-hw-volume = true
    bluez5.headset-roles = [ hsp_hs hsp_ag hfp_hf hfp_ag ]
}

# 降低蓝牙 A2DP sink 会话优先级(默认 1010)，使其连接后不抢默认
monitor.bluez.rules = [
    {
        matches = [ { node.name = "~bluez_output.*" } ]
        actions = {
            update-props = {
                priority.session = 500
            }
        }
    }
]
EOF
log_level "SUCCESS" "WirePlumber 蓝牙配置已创建"

log_level "STEP" "步骤5: 创建 root 运行时目录"
if [ "$(id -u)" = "0" ] && [ ! -d /run/user/0 ]; then
    mkdir -p /run/user/0 && chmod 700 /run/user/0 && chown root:root /run/user/0
    log_level "SUCCESS" "已创建 /run/user/0"
else
    log_level "DETAIL" "/run/user/0 已存在"
fi

log_level "STEP" "步骤6: 启用蓝牙服务"
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q 'bluetooth.service'; then
    systemctl enable bluetooth >/dev/null 2>&1
    systemctl start bluetooth >/dev/null 2>&1
    sleep 1
    systemctl is-active bluetooth 2>/dev/null | grep -q 'active' && log_level "SUCCESS" "bluetooth 服务已启动" || log_level "WARNING" "bluetooth 启动失败（可能缺少蓝牙硬件）"
else
    log_level "DETAIL" "bluetooth.service 不可用，跳过"
fi

log_level "STEP" "步骤7: 安装验证"

if command -v lsusb >/dev/null 2>&1; then
    BT_USB=$(lsusb 2>/dev/null | grep -iE 'bluetooth|wireless|radio|0bda:a728' || true)
    [ -n "$BT_USB" ] && log_level "SUCCESS" "检测到蓝牙适配器: $(echo "$BT_USB" | head -1)" || log_level "WARNING" "未检测到蓝牙适配器"
fi

if command -v pw-dump >/dev/null 2>&1; then
    PW_CARDS=$(pw-dump 2>/dev/null | python3 -c "
import json,sys
try:
    data=json.load(sys.stdin)
    cards=set()
    for obj in data:
        if isinstance(obj,dict) and obj.get('type')=='PipeWire:Interface:Device':
            props=obj.get('info',{}).get('props',{})
            name=props.get('device.name','')
            if name:
                cards.add(name)
    print(len(cards))
except: print(0)
" 2>/dev/null || echo "0")
    [ "$PW_CARDS" -gt 0 ] && log_level "SUCCESS" "检测到 $PW_CARDS 个 PipeWire 声卡" || log_level "WARNING" "未检测到 PipeWire 声卡"
fi

PY_RESULT=$(python3 -c "
import sys; missing=[]
for m in ['fastapi','uvicorn','dbus','gi']:
    try: __import__(m)
    except ImportError: missing.append(m)
print(','.join(missing) if missing else 'ok')
" 2>/dev/null || echo "failed")
if [ "$PY_RESULT" = "ok" ]; then
    log_level "SUCCESS" "Python 依赖验证通过"
else
    # 关键:用应用实际运行的同一个 python3 验证 import。若失败说明 apt 装的包
    # 与运行时 python3 环境不一致(NAS 常见)或未真正落地,尝试 --reinstall 补救并复验,
    # 避免"apt 报成功但 python3 import 不到 dbus"导致应用启动即 ModuleNotFoundError。
    log_level "WARNING" "Python 模块 import 失败: $PY_RESULT，尝试重装 python3-dbus/python3-gi..."
    DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y -qq python3-dbus python3-gi python3-fastapi python3-uvicorn >/dev/null 2>&1
    dpkg --configure -a >/dev/null 2>&1
    PY_RESULT2=$(python3 -c "
import sys; missing=[]
for m in ['fastapi','uvicorn','dbus','gi']:
    try: __import__(m)
    except ImportError: missing.append(m)
print(','.join(missing) if missing else 'ok')
" 2>/dev/null || echo "failed")
    if [ "$PY_RESULT2" = "ok" ]; then
        log_level "SUCCESS" "重装后 Python 依赖验证通过"
    else
        PY_BIN=$(command -v python3)
        log_level "ERROR" "重装后仍缺失: $PY_RESULT2 (python3=$PY_BIN)。请确认 apt 安装的 python 版本与运行时 python3 一致,蓝牙功能将不可用"
    fi
fi

log_level "STEP" "==================== PipeBridge 安装初始化完成 ===================="
exit 0
