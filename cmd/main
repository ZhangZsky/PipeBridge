#!/bin/bash
APP_DIR="${TRIM_APPDEST}"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_LOG_FILE="${TRIM_PKGVAR}/app.log"
# 统一网关 Unix Socket 路径（须与 app/ui/config 的 gatewaySocket 一致，位于应用 target 目录下）
GATEWAY_SOCKET="${APP_DIR}/app.sock"

check_process() {
    local pid=$1
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

cleanup_socket() {
    # 清理残留的网关 Socket 文件，避免 uvicorn 绑定失败
    if [ -S "${GATEWAY_SOCKET}" ] || [ -e "${GATEWAY_SOCKET}" ]; then
        echo "清理残留网关 Socket: ${GATEWAY_SOCKET}"
        rm -f "${GATEWAY_SOCKET}"
    fi
}

start_process() {
    echo "执行启动命令"

    if status; then
        echo "PipeBridge 已在运行中"
        return 0
    fi

    cleanup_socket

    echo "检查应用目录: ${APP_DIR}"
    if [ ! -d "${APP_DIR}" ]; then
        echo "应用目录不存在，启动失败" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi

    echo "检查应用入口文件: ${APP_DIR}/app.py"
    if [ ! -f "${APP_DIR}/app.py" ]; then
        echo "应用入口文件 app.py 不存在，启动失败" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi

    if ! command -v python3 > /dev/null 2>&1; then
        echo "Python3 运行环境未安装，请先安装 python3" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    PYTHON_VER=$(python3 --version 2>&1)
    echo "python3 检查通过: ${PYTHON_VER}"

    cd "${APP_DIR}" || return 1

    echo "正在启动 PipeBridge（统一网关模式），Socket: ${GATEWAY_SOCKET}"

    # 应用以 root 运行（需要 root 权限执行 driver_override/sysfs/systemctl 等操作）
    # PipeWire/WirePlumber 由应用内部以 root 拉起（0.32 行为还原），socket 位于
    # /run/user/0，其他应用可经该路径发现声卡；Python 侧 pgrep/pkill 均按
    # 目标 UID 过滤，保证全系统仅此一份 PW 实例（见 utils.py）。
    # TRIM_PKGVAR 决定前端"运行日志"读取的 app.log/install.log 路径。
    env TRIM_GATEWAY_SOCKET="app.sock" TRIM_APPDEST="${APP_DIR}" \
        TRIM_PKGVAR="${TRIM_PKGVAR}" \
        python3 "${APP_DIR}/app.py" >> "${APP_LOG_FILE}" 2>&1 &
    APP_PID=$!

    printf "%s" "${APP_PID}" > "${PID_FILE}"

    sleep 1
    if check_process "${APP_PID}"; then
        echo "PipeBridge 启动成功，PID: ${APP_PID}，Socket: ${GATEWAY_SOCKET}"
    else
        echo "PipeBridge 启动失败，进程已退出，请查看应用日志了解详情" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi

    return 0
}

stop_process() {
    echo "执行停止命令"

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        echo "从 PID 文件读取: ${pid}"

        if [ -n "$pid" ] && check_process "${pid}"; then
            echo "进程 ${pid} 正在运行，发送 TERM 信号"
            kill -TERM ${pid} 2>/dev/null

            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done

            if check_process "${pid}"; then
                echo "进程 ${pid} 未响应 TERM 信号，发送 KILL 信号"
                kill -KILL "${pid}" 2>/dev/null
                sleep 1
            fi
        else
            echo "PID 文件中的进程已不在运行"
        fi

        rm -f "${PID_FILE}"
    fi

    # 兜底清理残留 app.py 进程(应用以 root 运行,可能 PID 文件已丢失)
    local remaining
    remaining=$(pgrep -f "python3 ${APP_DIR}/app.py" 2>/dev/null)
    if [ -n "${remaining}" ]; then
        echo "发现残留应用进程: ${remaining}，正在清理..."
        kill -TERM ${remaining} 2>/dev/null
        sleep 2
        remaining=$(pgrep -f "python3 ${APP_DIR}/app.py" 2>/dev/null)
        if [ -n "${remaining}" ]; then
            kill -KILL ${remaining} 2>/dev/null
            sleep 1
        fi
    fi

    # PipeWire/WirePlumber 不在此处清理(0.32 行为): PW 由 nohup 拉起, 应用停止后
    # 继续存活, 其他应用仍可经 /run/user/0 的 socket 发现声卡; 下次启动时
    # start_pw_service 通过 pgrep 幂等复用现有实例, 不会双实例。
    # 旧版(0.33) pipebridge 用户的残留实例由 utils._stop_legacy_user_pw 在启动时清理。

    cleanup_socket

    echo "PipeBridge 停止成功"
    return 0
}

status() {
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "$pid" ] && check_process "$pid"; then
            echo "PipeBridge 正在运行，PID: ${pid}"
            return 0
        else
            rm -f "${PID_FILE}"
            echo "PipeBridge 未运行"
            return 1
        fi
    else
        echo "PipeBridge 未运行"
        return 1
    fi
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    echo "用法: $0 {start|stop|status}"
    exit 1
    ;;
esac
