#!/bin/bash
log_level() {
    local level="$1" message="$2"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    case "$level" in
        "INFO")    echo "[$timestamp] [INFO]    $message" ;;
        "SUCCESS") echo "[$timestamp] [SUCCESS] $message" ;;
        "WARNING") echo "[$timestamp] [WARNING] $message" ;;
        "ERROR")   echo "[$timestamp] [ERROR]   $message" ;;
        "STEP")    echo "[$timestamp] [STEP]    $message" ;;
        "DETAIL")  echo "[$timestamp] [DETAIL]  $message" ;;
        *)         echo "[$timestamp] [INFO]    $message" ;;
    esac
}

log_level "STEP" "==================== PipeBridge 卸载清理 ===================="

log_level "STEP" "步骤1: 停止进程"

APP_PID_FILE="${TRIM_PKGVAR}/app.pid"
if [ -r "$APP_PID_FILE" ]; then
    pid=$(head -n 1 "$APP_PID_FILE" | tr -d '[:space:]')
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null; sleep 3
        kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
        log_level "DETAIL" "已停止应用进程 (PID: $pid)"
    fi
    rm -f "$APP_PID_FILE"
fi

remaining=$(pgrep -f "python3.*app.py.*PipeBridge" 2>/dev/null || true)
if [ -n "$remaining" ]; then
    kill -TERM $remaining 2>/dev/null; sleep 2
    pgrep -f "python3.*app.py.*PipeBridge" 2>/dev/null | xargs kill -KILL 2>/dev/null
    log_level "DETAIL" "已清理残留应用进程"
fi

for proc_name in wireplumber pipewire-pulse pipewire; do
    pgrep -x "$proc_name" >/dev/null 2>&1 && pkill -x "$proc_name" 2>/dev/null && log_level "DETAIL" "已停止 $proc_name"
done
sleep 1

if [ "$(id -u)" = "0" ]; then
    DBUS_PID=$(pgrep -f "dbus-daemon.*--session.*unix:path=/run/user/0/bus" 2>/dev/null || true)
    [ -n "$DBUS_PID" ] && kill "$DBUS_PID" 2>/dev/null && log_level "DETAIL" "已停止 D-Bus 会话守护进程"
fi

log_level "SUCCESS" "进程停止完成"

log_level "STEP" "步骤2: 禁用蓝牙服务"
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q 'bluetooth.service'; then
    systemctl stop bluetooth >/dev/null 2>&1
    systemctl disable bluetooth >/dev/null 2>&1
    log_level "SUCCESS" "已停止并禁用 bluetooth 服务"
else
    log_level "DETAIL" "bluetooth.service 不可用，跳过"
fi

log_level "STEP" "步骤3: 清理 WirePlumber 配置"

WP_CONF_DIR="/etc/wireplumber/wireplumber.conf.d"
for f in "$WP_CONF_DIR"/51-pipebridge-bluez.conf \
         "$WP_CONF_DIR"/51-pipebridge-iec958.conf; do
    [ -f "$f" ] && rm -f "$f" && log_level "DETAIL" "已删除: $f"
done

[ -d "$WP_CONF_DIR" ] && rm -f "$WP_CONF_DIR"/*pipebridge*.conf 2>/dev/null && log_level "DETAIL" "已清理残留 PipeBridge 规则"

for user_dir in /root/.config/wireplumber/wireplumber.conf.d; do
    [ -d "$user_dir" ] && rm -f "$user_dir"/*pipebridge*.conf
done

for lua_dir in /etc/wireplumber/main.lua.d /root/.config/wireplumber/main.lua.d; do
    [ -d "$lua_dir" ] && rm -f "$lua_dir"/*pipebridge*.lua
done

log_level "SUCCESS" "WirePlumber 配置已清理"

log_level "STEP" "步骤4: 清理运行时残留"

if [ -d /run/user/0 ]; then
    rm -f /run/user/0/pipewire-0 /run/user/0/pipewire-0.lock /run/user/0/bus 2>/dev/null
    rm -rf /run/user/0/wireplumber 2>/dev/null
    log_level "DETAIL" "已清理 /run/user/0 运行时文件"
fi

rm -f /tmp/pipewire-0.log /tmp/pipewire-pulse-0.log /tmp/wireplumber-0.log 2>/dev/null

rm -rf /root/.local/state/wireplumber 2>/dev/null && log_level "DETAIL" "已清理 WirePlumber 状态缓存"

rm -rf /root/.config/pipebridge 2>/dev/null && log_level "DETAIL" "已清理 PipeBridge 配置目录"

log_level "SUCCESS" "运行时残留已清理"

log_level "STEP" "步骤5: 卸载依赖包"

UNINSTALL_LIST=(
    pipewire
    pipewire-pulse
    pipewire-alsa
    wireplumber
    libspa-0.2-bluetooth
    alsa-utils
    bluez
    bluez-tools
    beep
    python3-dbus
    python3-gi
    python3-fastapi
    python3-uvicorn
    firmware-realtek
    bluez-firmware
)

TO_REMOVE=()
for pkg in "${UNINSTALL_LIST[@]}"; do
    dpkg -s "$pkg" 2>/dev/null | grep -q "^Status: install ok installed" && TO_REMOVE+=("$pkg")
done

if [ ${#TO_REMOVE[@]} -gt 0 ]; then
    log_level "INFO" "卸载 ${#TO_REMOVE[@]} 个包: ${TO_REMOVE[*]}"
    DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq "${TO_REMOVE[@]}" >/dev/null 2>&1
    apt-get autoremove -y -qq >/dev/null 2>&1
fi

for pkg in "${UNINSTALL_LIST[@]}"; do
    if dpkg -s "$pkg" 2>/dev/null | grep -q "^Status: install ok installed"; then
        log_level "ERROR" "$pkg 卸载失败"
    else
        log_level "SUCCESS" "$pkg 已卸载"
    fi
done

log_level "STEP" "==================== PipeBridge 卸载清理完成 ===================="
exit 0
